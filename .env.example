# 이 파일을 복사해 .env 로 저장하고 실제 값을 입력하세요. (.env 는 GitHub에 올리지 않습니다)
OPENAI_API_KEY=sk-...

# true 이면 AI를 호출하지 않고 테스트용 응답을 돌려줍니다. (비용 없음, 기본값 false)
# MOCK_STYLING=true

# (선택) 아래 값은 기본값이 있어 생략해도 됩니다.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=medium        # low | medium | high | xhigh | max | auto
# RATE_LIMIT_MAX=5                   # IP당 요청 횟수 (0이면 제한 없음)
# RATE_LIMIT_WINDOW_MIN=10           # 위 횟수를 세는 시간(분)
# PORT=3000
